import sys
from pathlib import Path

# Add apps/api to path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from fastapi import status
from starlette.requests import Request
from starlette.datastructures import Headers
from app.main import app

# Create mock ASGI scope for GET /r/abc123
scope = {
    "type": "http",
    "http_version": "1.1",
    "method": "GET",
    "path": "/r/abc123",
    "raw_path": b"/r/abc123",
    "query_string": b"",
    "headers": [(b"host", b"localhost:8000")],
    "scheme": "http",
    "server": ("localhost", 8000),
    "client": ("127.0.0.1", 54321),
}

async def run():
    print("=== REPRODUCING MODULE 03 BREAK SYMPTOM ===")
    print("Simulating HTTP request: GET /r/abc123")
    
    response_started = False
    response_status = None
    response_headers = []
    response_body = bytearray()
    
    async def receive():
        return {"type": "http.request", "body": b"", "more_body": False}
        
    async def send(message):
        nonlocal response_started, response_status, response_headers, response_body
        if message["type"] == "http.response.start":
            response_started = True
            response_status = message["status"]
            response_headers = message.get("headers", [])
        elif message["type"] == "http.response.body":
            response_body.extend(message.get("body", b""))

    await app(scope, receive, send)
    
    print(f"HTTP Status Code: {response_status}")
    print(f"Response Body: {response_body.decode('utf-8')}")
    if response_status == 405:
        print("Symptom Confirmed: Expected 307 Temporary Redirect, but received 405 Method Not Allowed!")

if __name__ == "__main__":
    import asyncio
    asyncio.run(run())
